<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>AttachExtract</RootNamespace>
    <AssemblyName>AttachExtract</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>

    <!-- Modern, high-DPI aware WinForms rendering -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspose.Total license (Aspose.Total.lic / Aspose.Email.lic) covers both packages below.
         Bump the versions to match the Aspose.Total 24.10 release train.
         Aspose.Words is required because Aspose.Email cannot render a MailMessage straight to
         PDF; the conversion goes MSG -> MHTML (Aspose.Email) -> PDF (Aspose.Words). -->
    <PackageReference Include="Aspose.Email" Version="24.10.0" />
    <PackageReference Include="Aspose.Words" Version="24.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drop a licensed .lic file next to the .csproj (kept out of source control, see .gitignore)
         and it will be copied beside the executable so AsposeLicenseManager can find it at startup. -->
    <None Include="Aspose.Total.lic" Condition="Exists('Aspose.Total.lic')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Aspose.Email.lic" Condition="Exists('Aspose.Email.lic')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
